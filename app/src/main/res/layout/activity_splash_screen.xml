<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <ImageView
        android:id="@+id/backgroundDie"
        android:layout_width="260dp"
        android:layout_height="516dp"
        android:layout_gravity="start|top"
        android:alpha="0.85"
        android:scaleType="fitXY"
        android:src="@drawable/die"
        android:translationX="41dp"
        android:translationY="-48dp" />

    <LinearLayout
        android:id="@+id/activity_splash_screen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="32dp"
        android:paddingEnd="32dp">

        <ImageView
            android:id="@+id/photoView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:maxWidth="260dp"
            android:maxHeight="120dp"
            android:scaleType="fitCenter"
            android:src="@drawable/logo_tn_2025" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/chargement"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="48dp"
        android:paddingEnd="48dp"
        android:paddingBottom="54dp">

        <TextView
            android:id="@+id/textLoading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="start"
            android:fontFamily="sans-serif-medium"
            android:text="Chargement des données"
            android:textColor="#4D4D4D"
            android:textSize="14sp" />

        <ProgressBar
            android:id="@+id/progressLoading"
            style="@android:style/Widget.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:layout_marginTop="10dp"
            android:max="100"
            android:progress="28"
            android:progressDrawable="@drawable/progress_green" />

    </LinearLayout>

</FrameLayout>
